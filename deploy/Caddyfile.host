# Add this to the Caddy already on the VPS. APPEND it to /etc/caddy/Caddyfile -
# do not replace the file. A VPS is rarely serving one thing, and overwriting
# that file takes every other site on the machine down with it.
#
#   sudo tee -a /etc/caddy/Caddyfile < deploy/Caddyfile.host
#   sudo sed -i 's/neutv.your-domain.com/<your hostname>/' /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy      # reload, not restart: no dropped connections
#
# The hostname has to appear in three places and match in all of them:
#   - here
#   - API_DOMAIN in .env, which is what the RTMP and HLS URLs are built from
#   - NEUTV_API_BASE on both Vercel projects
#
# This is the same configuration as deploy/Caddyfile, which the caddy container
# uses. The only difference is the upstreams: that one reaches its neighbours by
# compose service name, this one is outside the compose network and uses the
# loopback ports the compose file publishes.

neutv.your-domain.com {
	encode zstd gzip

	# Live HLS from MediaMTX. handle_path strips the prefix, because MediaMTX
	# serves at its root: /hls/live-abc/index.m3u8 here is
	# /live-abc/index.m3u8 there.
	handle_path /hls/* {
		reverse_proxy 127.0.0.1:8888
	}

	handle {
		reverse_proxy 127.0.0.1:4173 {
			# The live event stream is server-sent events, held open for as long
			# as the tab is. Without this Caddy buffers the response and nothing
			# reaches the page until the connection closes, which for SSE never
			# happens.
			flush_interval -1
		}
	}

	# Video is uploaded through the API on its way to Cloudinary. The default
	# 10MB cap would reject every one of them.
	request_body {
		max_size 2GB
	}
}
