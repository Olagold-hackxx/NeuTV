# Site block for the Caddy already running on the VPS.
#
# Generated by: npm run deploy:caddy -- --api <hostname>
# Do not edit the generated output; change API_DOMAIN and regenerate, so the
# hostname has one source of truth rather than three that drift.
#
# APPEND the output to /etc/caddy/Caddyfile - never replace it. A VPS is rarely
# serving one thing, and overwriting that file takes every other site with it:
#
#   npm run deploy:caddy -- --api api.example.com | sudo tee -a /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# This hostname must point at THIS server and nothing else. If it also resolves
# to a CDN, half the traffic gets the CDN's default certificate and every one of
# those requests fails TLS. Run `npm run check:domain` first.

{{API_DOMAIN}} {
	encode zstd gzip

	# WHIP: the studio publishes its camera here as a WebRTC peer connection.
	# Signalling only - the media itself goes direct to MediaMTX on the ICE ports,
	# which is why those are published rather than proxied.
	handle_path /whip/* {
		reverse_proxy 127.0.0.1:8889
	}

	# Live HLS from MediaMTX. handle_path strips the prefix, because MediaMTX
	# serves at its root: /hls/live-abc/index.m3u8 here is
	# /live-abc/index.m3u8 there.
	handle_path /hls/* {
		reverse_proxy 127.0.0.1:8888
	}

	handle {
		reverse_proxy 127.0.0.1:4173 {
			# The live event stream is server-sent events, held open for as long
			# as the tab is. Without this Caddy buffers the response and nothing
			# reaches the page until the connection closes, which for SSE never
			# happens.
			flush_interval -1
		}
	}

	# Video uploads stream through the API. The default 10MB body cap would
	# reject them before they got anywhere.
	request_body {
		max_size 2GB
	}

	log {
		output stderr
		format console
	}
}
