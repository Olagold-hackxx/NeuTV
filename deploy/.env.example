# Copy to .env in the repo root, next to docker-compose.yml, and fill in.
# Compose refuses to start without the ones marked required.

# --- required ---------------------------------------------------------------

# The hostname this VPS answers on. Caddy gets a certificate for it, so it has
# to resolve to this machine - and ONLY this machine - before the first
# `docker compose up`.
#
# It must never also point at a CDN. Pointing one name at both the origin and
# Fastly makes DNS round-robin between them; the CDN answers with its default
# certificate and those requests all fail TLS, while the server looks healthy.
# Check it with: npm run check:domain -- --api $API_DOMAIN
API_DOMAIN=api.example.com

# Postgres. Any long random string; nothing outside the compose network can
# reach the database, but it is still a password.
POSTGRES_PASSWORD=

# Who gets the back office. Comma separated. Roles come from the deployment,
# never from signing up.
NEUTV_ADMIN_EMAILS=you@example.com

# --- video storage ----------------------------------------------------------
# Cloudinary stores and transcodes. No bucket is involved; this is an
# alternative to S3, not an addition to it.

NEUTV_MEDIA_DRIVER=cloudinary
NEUTV_CLOUDINARY_CLOUD_NAME=
NEUTV_CLOUDINARY_API_KEY=
NEUTV_CLOUDINARY_API_SECRET=
NEUTV_CLOUDINARY_FOLDER=videos

# Where players fetch video from: Fastly in front of Cloudinary. The stored
# path is relative, so this is the only thing that changes if the CDN does.
#
#   direct:      https://res.cloudinary.com/<cloud-name>/video/upload
#   via Fastly:  https://cdn.your-domain.com/<cloud-name>/video/upload
#
# Point the Fastly service at res.cloudinary.com as its origin, then use the
# Fastly hostname here so video never touches the VPS.
NEUTV_MEDIA_BASE_URL=https://cdn.example.com/<cloud-name>/video/upload

# Delivery transform, inserted into the playback URL. Cloudinary reads it from
# the URL, so it stores nothing extra.
#
# This is not an optimisation, it is what makes large uploads playable at all:
# a 28-second 1080p file arrives at ~50MB, and a CDN refuses to buffer an object
# that size ("Response object too large"), so it never reaches a viewer. q_auto
# brings the same clip to ~5MB with no visible difference.
#
# Defaults to q_auto,f_auto on the cloudinary driver and to nothing on the
# others, which serve the bytes they were given. Set it empty to turn off.
# NEUTV_MEDIA_TRANSFORM=q_auto,f_auto

# The CDN hostname, used only by `npm run check:domain`. It must be a DIFFERENT
# name from API_DOMAIN.
CDN_DOMAIN=cdn.example.com

# --- live -------------------------------------------------------------------
# mediamtx: the container in this compose file. OBS publishes RTMP to it and it
#           republishes HLS, which Caddy serves at /hls.
# manual:   you stream somewhere else and paste the playback URL yourself.
# mux / cloudflare: hosted, and they mint the URLs for you.
NEUTV_LIVE_DRIVER=mediamtx

# Where MediaMTX is reachable. The studio publishes to the WHIP URL as a WebRTC
# peer connection, which is what gets ingest under a second; viewers get the
# low-latency HLS URL, which stays a plain manifest a CDN can cache.
#
# The RTMP URL is for an encoder like OBS, and is optional if nobody uses one.
NEUTV_MEDIAMTX_WHIP_BASE=https://api.example.com/whip
NEUTV_MEDIAMTX_HLS_BASE=https://api.example.com/hls
NEUTV_MEDIAMTX_RTMP_URL=rtmp://api.example.com:1935
