# Copy to .env in the repo root, next to docker-compose.yml, and fill in.
# Compose refuses to start without the ones marked required.

# --- required ---------------------------------------------------------------

# The hostname this VPS answers on. Caddy gets a certificate for it, so it has
# to resolve to this machine before the first `docker compose up`.
API_DOMAIN=neutv.tsionark.io

# Postgres. Any long random string; nothing outside the compose network can
# reach the database, but it is still a password.
POSTGRES_PASSWORD=

# Who gets the back office. Comma separated. Roles come from the deployment,
# never from signing up.
NEUTV_ADMIN_EMAILS=you@your-domain.com

# --- video storage ----------------------------------------------------------
# Cloudinary stores and transcodes. No bucket is involved; this is an
# alternative to S3, not an addition to it.

NEUTV_MEDIA_DRIVER=cloudinary
NEUTV_CLOUDINARY_CLOUD_NAME=
NEUTV_CLOUDINARY_API_KEY=
NEUTV_CLOUDINARY_API_SECRET=
NEUTV_CLOUDINARY_FOLDER=videos

# Where players fetch video from: Fastly in front of Cloudinary. The stored
# path is relative, so this is the only thing that changes if the CDN does.
#
#   direct:      https://res.cloudinary.com/<cloud-name>/video/upload
#   via Fastly:  https://cdn.your-domain.com/<cloud-name>/video/upload
#
# Point the Fastly service at res.cloudinary.com as its origin, then use the
# Fastly hostname here so video never touches the VPS.
NEUTV_MEDIA_BASE_URL=https://cdn.your-domain.com/<cloud-name>/video/upload

# --- live -------------------------------------------------------------------
# mediamtx: the container in this compose file. OBS publishes RTMP to it and it
#           republishes HLS, which Caddy serves at /hls.
# manual:   you stream somewhere else and paste the playback URL yourself.
# mux / cloudflare: hosted, and they mint the URLs for you.
NEUTV_LIVE_DRIVER=mediamtx
