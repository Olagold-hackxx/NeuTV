node_modules/
*.log
.env
.env.*
# ...but the templates are the documentation for what to fill in.
!.env.example
!**/.env.example
.DS_Store

# Runtime state, never committed: per-service SQLite stores and uploaded video.
# Matched by suffix as well as by path, so a store written from an unexpected
# working directory cannot slip in - which is exactly how it slipped in once.
**/data/
*.db
*.db-wal
*.db-shm
/tmp/
