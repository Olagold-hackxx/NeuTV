# Copy to .env and edit. Loaded automatically by `npm start`.

# --- accounts ---------------------------------------------------------------
# Emails granted the back-office admin role. Comma separated.
# Create the account itself with: npm run admin:create -- --email you@example.com --generate
NEUTV_ADMIN_EMAILS=you@example.com

# --- database ---------------------------------------------------------------
# Unset: each service keeps its own SQLite file under services/*/data/.
# Set:   all services share one Postgres database, each in its own SCHEMA.
# DATABASE_URL=postgres://user:pass@host:5432/neutv

# Move existing SQLite data across with:
#   npm run migrate:postgres -- --url postgres://... --dry-run

# --- video storage ----------------------------------------------------------
# Pick ONE. They are alternatives, not layers - an S3 bucket is not needed to
# use Cloudinary, or the other way round.
#
# local (default): files on disk, served by the gateway at /media with byte ranges.
# cloudinary:      Cloudinary stores and transcodes; put any CDN in front of it.
# s3:              any S3-compatible bucket (Cloudflare R2, AWS S3, B2, Spaces, MinIO).

# NEUTV_MEDIA_DRIVER=cloudinary
# NEUTV_CLOUDINARY_CLOUD_NAME=
# NEUTV_CLOUDINARY_API_KEY=
# NEUTV_CLOUDINARY_API_SECRET=
# NEUTV_CLOUDINARY_FOLDER=videos

# NEUTV_MEDIA_DRIVER=s3
# NEUTV_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# NEUTV_S3_BUCKET=neutv-video
# NEUTV_S3_REGION=auto
# NEUTV_S3_ACCESS_KEY_ID=
# NEUTV_S3_SECRET_ACCESS_KEY=
# NEUTV_S3_PREFIX=videos

# Where players fetch video from. Point it at the CDN in front of the bucket so
# video is served from the edge and never touches the API.
# NEUTV_MEDIA_BASE_URL=https://cdn.neu.tv

# --- live streaming ---------------------------------------------------------
# manual (default): you stream wherever you already do (OBS to YouTube Live, or
#   your own MediaMTX / nginx-rtmp) and paste the public playback URL. No
#   accounts, no infrastructure.
# mux / cloudflare: an RTMP ingest endpoint and HLS playback are minted for you.
# NEUTV_LIVE_DRIVER=mux
# NEUTV_MUX_TOKEN_ID=
# NEUTV_MUX_TOKEN_SECRET=
# NEUTV_LIVE_DRIVER=cloudflare
# NEUTV_CF_ACCOUNT_ID=
# NEUTV_CF_API_TOKEN=

# --- misc -------------------------------------------------------------------
# PORT=4173
# NEUTV_FRONTEND_ROOT=../frontend
